{
  "input_csv": "../russian_RadEvalX.csv",
  "image_root": "../",
  "columns": {
    "row_id": "report_id",
    "candidate": "M2Tr-Generation_ru",
    "reference": "ground_truth_ru",
    "image": "path_to_image",
    "target": "SIG_error_count"
  },
  "translators": ["qwen", "hy_mt", "translategemma"],
  "translation_kinds": ["terms", "noterms"],
  "methods": ["radgraph_partial", "radcliq", "ratescore", "cosinesim_cxrbert", "cosinesim_biovilt", "bertscore_cxrbert", "bertscore_biovilt"],
  "models": {
    "qwen_translator_model": "Qwen/Qwen3.5-9B",
    "hy_mt_model": "tencent/HY-MT1.5-7B",
    "translategemma_model": "google/translategemma-12b-it",
    "green_model": "Qwen/Qwen3.5-9B",
    "cxrbert_model": "microsoft/BiomedVLP-CXR-BERT-specialized",
    "biovilt_model": "microsoft/BiomedVLP-BioViL-T"
  },
  "environments": {
    "translate.qwen": "cxr-qwen",
    "translate.hy_mt": "cxr-qwen",
    "translate.translategemma": "cxr-qwen",
    "green": "cxr-qwen",
    "text": "cxr-text",
    "image": "cxr-image"
  },
  "runtime": {
    "device": "cuda",
    "translation_max_new_tokens": 1024,
    "green_max_new_tokens": 2048,
    "green_batch_size": 1,
    "text_batch_size": 16,
    "image_batch_size": 16
  },
  "training": {
    "k_outer": 5, "k_inner": 5, "weight_step": 0.05,
    "random_state": 42, "lower_transform": "reciprocal"
  }
}
